# Which AI provider to use: ollama, openai, or anthropic
# This lab is chat-only (no embeddings), so all three providers work.
PROVIDER=ollama

# Only needed if PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Only needed if PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# No Traceloop account or API key needed -- this lab exports traces to
# your own console by default.

# Only needed for the LangSmith bonus (free account, no Docker required).
# Get a key at https://smith.langchain.com -> Settings -> API Keys.
# LANGSMITH_API_KEY=lsv2_...

# Which AI provider to use: ollama, openai, or anthropic
# This lab is chat-only (no embeddings), so all three providers work.
PROVIDER=ollama

# Only needed if PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Only needed if PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Only needed when running inside Docker with PROVIDER=ollama -- "localhost"
# inside a container means the container itself, not your Mac. See README.md.
# OLLAMA_URL=http://host.docker.internal:11434

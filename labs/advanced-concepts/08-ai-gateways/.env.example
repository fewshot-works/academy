# This lab is different from most others in this course: it needs TWO
# backends configured, a PRIMARY and a FALLBACK, because the whole point is
# watching a gateway switch between them when the primary is down.

# The primary provider: ollama, openai, or anthropic.
# This lab simulates PRIMARY_PROVIDER having an outage, so its actual
# real-world reliability doesn't matter for the demo.
PRIMARY_PROVIDER=openai

# The fallback provider, only ever called when the primary fails.
# Defaults to ollama since it's free and most labs in this course already
# assume it's installed locally.
FALLBACK_PROVIDER=ollama

# Only needed if PRIMARY_PROVIDER or FALLBACK_PROVIDER is openai
# OPENAI_API_KEY=sk-...

# Only needed if PRIMARY_PROVIDER or FALLBACK_PROVIDER is anthropic
# ANTHROPIC_API_KEY=sk-ant-...

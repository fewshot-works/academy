# This lab is different from most others in this course: it names TWO
# distinct backends, a PRIMARY and a FALLBACK, because the whole point is
# watching a gateway switch when the primary is down. The primary outage is
# simulated before any network call, so only the fallback needs to be live.

# The primary provider: ollama, openai, or anthropic.
# This lab simulates PRIMARY_PROVIDER having an outage, so its actual
# real-world reliability doesn't matter for the demo.
PRIMARY_PROVIDER=openai

# The fallback provider, only ever called when the primary fails.
# Defaults to ollama since it's free and most labs in this course already
# assume it's installed locally. It must differ from PRIMARY_PROVIDER or
# both attempts will hit the simulated primary outage.
FALLBACK_PROVIDER=ollama

# Only needed when FALLBACK_PROVIDER is openai. The simulated primary is
# never contacted in this lab.
# OPENAI_API_KEY=sk-...

# Only needed when FALLBACK_PROVIDER is anthropic. The simulated primary is
# never contacted in this lab.
# ANTHROPIC_API_KEY=sk-ant-...
